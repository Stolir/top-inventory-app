<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/global.css" />
    <script src="/js/searchOverlay.js" defer></script>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js" defer></script>
    <script src="/js/editGameOverlay.js" defer></script>
    <title><%= title %></title>
  </head>
  <body>
    <div id="page-content">
      <%- include('partials/header', {links}) %>
      <div class="main-container">
        <h1><%= title %></h1>
        <section class="gamelist-container">
          <% games.forEach(game => { %> <%- include('partials/gameCard', {game})
          %> <% }) %>
        </section>
      </div>
      <button class="add-new game"><img src="/icons/plus-circle-solid.svg" alt="add new game"></button>
    </div>
    <%- include('partials/searchOverlay') %>
    <%- include('partials/editGameOverlay', {action: `add`, allTags, allDevelopers, genres}) %>
    <% if (typeof errors !== 'undefined') { %>
     <%- include('partials/errorAlert', {errors}) %>
    <% } %>
  </body>
</html>
