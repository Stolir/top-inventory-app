<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/global.css" />
    <title><%= game.name %></title>
    <script src="/js/searchOverlay.js" defer></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js" defer></script>
    <script src="/js/editGameOverlay.js" defer></script>
  </head>
  <body>
    <div id="page-content">
      <%- include('partials/header', {links}) %>
      <section class="game-container">
        <div class="game-container__img">
          <img src="<%= game.cover_img_url %>" alt="" />
        </div>
        <div class="game-container__info">
          <h2><%= game.name %></h2>
          <p>Release Date: <%= new Date(game.release_date).toLocaleDateString('en-CA') %></p>
           <p>Rating: <%= game.rating %></p>
          <p>
            Genre: <a href="/genres/<%= game.genre_id %>"><%= game.genre %></a>
          </p>
         
          <p>
            Tags: <% tags.forEach(tag => { %>
            <a href="/tags/<%= tag.id %>"><%= tag.name %></a>
            <% }) %>
          </p>
          <p>
            Developers: <% developers.forEach(developer => { %>
            <a href="/developers/<%= developer.developer_id %>"
              ><%= developer.name %></a
            >
            <% }) %>
          </p>
          <div class="game-container__controls">
            <form
              action="/games/<%= game.id %>/delete"
              method="POST"
              onsubmit="return confirm('Are you sure you want to delete <%= game.name %>?')"
            >
              <button type="submit">Delete</button>
            </form>
            <button id="updateGame" type="button">Update</button>
          </div>
        </div>
      </section>
    </div>
    <%- include('partials/searchOverlay') %>
    <%- include('partials/editGameOverlay', {game, genres, action: `${game.id}/update`, tags, developers, allTags, allDevelopers}) %>
    <% if (typeof errors !== 'undefined') { %>
     <%- include('partials/errorAlert', {errors}) %>
    <% } %>
  </body>
</html>
