<div class="search-section-container" hidden>
  <section class="search-section">
    <button class="search-section__close" type="button">
      <img src="/icons/xmark.svg" alt="close search" width="32" />
    </button>
    <input type="text" placeholder="Search for games, genres, tags, devs" />
    <section class="search-section__results">
      <section class="search-section__results-games" hidden></section>
      <section class="search-section__results-genres" hidden></section>
      <section class="search-section__results-developers" hidden></section>
      <section class="search-section__results-tags" hidden></section>
    </section>
  </section>
</div>
