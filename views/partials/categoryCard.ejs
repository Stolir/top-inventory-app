<div class="category-card">
  <a href="/<%= category %>/<%= item.id %>"><%= item.name %></a>
  <form
    action="/<%= category %>/<%= item.id %>/delete"
    method="POST"
    onsubmit="
      return confirm('Are you sure you want to delete <%= item.name %>?');
    "
  >
    <button>
      <img src="/icons/trash-solid.svg" alt="delete <%= category %>" />
    </button>
  </form>
</div>
