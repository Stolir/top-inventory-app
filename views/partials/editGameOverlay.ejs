<div id="edit-backdrop" hidden>
  <section class="edit-game-overlay">
    <form action="/games/<%= action %>" method="POST">
      <div>
        <label for="gameName">Game Name</label>
        <input type="text" name="gameName" value="<%= typeof game !== "undefined" ? game.name : "" %>" required/>
      </div>
      <div>
        <label for="rating">Rating</label>
        <input 
          type="number" 
          step="0.1" 
          min="0" 
          max="10" 
          name="rating" 
          pattern="^[a-zA-Z0-9\s\-:_]{1,255}$" 
          title="Game name can only include letters, numbers, spaces, and - : _"
          value="<%= typeof game !== "undefined" ? game.rating : "" %>"/>
      </div>
      <div>
        <label for="release_date">Release Date</label>
        <input type="date" name="release_date" value="<%= typeof game !== "undefined" ? new Date(game.release_date).toLocaleDateString('en-CA') : "" %>" required />
      </div>
      <div>
        <label for="genre">Genre</label>
        <select name="genre" id="genre" required>
          <option value="" disabled selected>-- Select Game Genre --</option>
          <% genres.forEach(genre => { %>
          <option value="<%= genre.id %>" <%= typeof game !== "undefined" && game.genre === genre.name ? 'selected' : '' %>><%= genre.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="developers">Developer</label>
        <select name="developers[]" id="developers-select" multiple required>
          <% allDevelopers.forEach(developer => { %>
           <option value="<%= developer.id %>" <%= typeof game !== "undefined" && developers.some(gameDev => gameDev.developer_id === developer.id) ? "selected" : "" %>><%= developer.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="tags">Tags</label>
        <select name="tags[]" id="tags-select" multiple>
          <% allTags.forEach(tag => { %>
           <option value="<%= tag.id %>" <%= typeof game !== "undefined" && tags.some(gameTag => gameTag.tag_id === tag.id) ? "selected" : "" %>><%= tag.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="cover_img_url">Cover Image URL</label>
        <input
          type="url"
          name="cover_img_url"
          placeholder="Link to cdn cover image URL"
          value="<%= typeof game !== "undefined" ? game.cover_img_url : ""%>"
        />
      </div>
      <div class="edit-game-overlay__controls">
        <button type="submit">Save</button>
        <button id="cancel-edit" type="button">Cancel</button>
      </div>
    </form>
  </section>
</div>
