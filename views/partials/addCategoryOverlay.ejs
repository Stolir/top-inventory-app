<div id="edit-backdrop" class="category" hidden>
  <section class="edit-game-overlay">
    <form action="/<%= category %>/add" method="POST">
      <div>
        <label for="name"><%= title.slice(0, -1)%> Name</label>
        <input type="text" name="name" required />
      </div>
      <div class="edit-game-overlay__controls">
        <button type="submit">Save</button>
        <button id="cancel-edit" type="button">Cancel</button>
      </div>
    </form>
  </section>
</div>
